{
  "name": "RAG DevContainer",
  "image": "python:3.11",
  "features": {
    "./features/poetry_install": {},
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        //python extensions
        "ms-python.python",
        "ms-python.black-formatter",
        "ms-python.isort",
        "ms-python.vscode-pylance",
        "donjayamanne.python-extension-pack",
        "ms-toolsai.jupyter",
        //formatting
        "esbenp.prettier-vscode",
        //ci/cd
        "github.vscode-github-actions",
        //javascript extensions
        "dbaeumer.vscode-eslint",
        "rvest.vs-code-prettier-eslint",
        "svelte.svelte-vscode"
      ]
    }
  },
  // to ensure local ssh keys available in devcontainer
  "remoteEnv": {
    "SSH_AUTH_SOCK": "/ssh-agent.sock"
  },
  "mounts": [
    "source=${localEnv:SSH_AUTH_SOCK},target=/ssh-agent.sock,type=bind",
    "source=${localEnv:HOME}/.ssh/known_hosts,target=/root/.ssh/known_hosts,type=bind,consistency=cached"
  ]
}
